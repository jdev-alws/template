---
import SectionTag from './ui/SectionTag.astro';
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';
import { plans } from '../data/content';
---
<section id="pricing" class="section-y bg-ivory" aria-labelledby="pricing-title">
  <div class="container-x">
    <header class="mx-auto max-w-xl text-center">
      <SectionTag text="Pricing" />
      <h2 id="pricing-title" class="h-section mt-5" data-split>Real Guests. Radiant Results.</h2>
      <p class="lede mt-4" data-reveal>Clear packages, no surprises. Every plan includes a consultation and a home-care plan.</p>
    </header>

    <div class="mt-14 grid gap-5 md:grid-cols-2">
      {plans.map((p) => (
        <article class:list={['card grid gap-5 p-4 sm:grid-cols-[0.95fr_1fr] sm:p-5', p.featured && 'ring-1 ring-accent/40']} data-reveal aria-labelledby={`plan-${p.name}`}>
          <div class="relative overflow-hidden rounded-2xl">
            <img src={p.image} alt="" class="aspect-[4/3] h-full w-full object-cover sm:aspect-auto" loading="lazy" decoding="async" />
            <div class="absolute inset-x-3 bottom-3 rounded-xl bg-white/90 px-4 py-3 text-center backdrop-blur">
              <p class="font-serif text-3xl leading-none">${p.price}</p>
              <p class="mt-1 text-[11px] text-muted">{p.unit}</p>
            </div>
            {p.featured && <span class="absolute left-3 top-3 rounded-full bg-accent px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.16em] text-white">Most booked</span>}
          </div>
          <div class="flex flex-col py-1">
            <div class="flex items-center justify-between gap-3">
              <h3 id={`plan-${p.name}`} class="font-serif text-2xl">{p.name}</h3>
              <span class="chip"><Icon name="clock" size={12} />{p.duration}</span>
            </div>
            <ul class="mt-4 space-y-2.5">
              {p.features.map((f) => (
                <li class="flex items-start gap-2.5 text-[13px]">
                  <span class="mt-0.5 grid h-4 w-4 shrink-0 place-items-center rounded-full bg-accent-soft text-accent"><Icon name="check" size={10} /></span>{f}
                </li>
              ))}
            </ul>
            <div class="mt-6 sm:mt-auto sm:pt-6"><Button label="Choose Plan" variant={p.featured ? 'primary' : 'dark'} ariaLabel={`Choose ${p.name} plan`} /></div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
