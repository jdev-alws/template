---
import SectionTag from './ui/SectionTag.astro';
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';
import { services } from '../data/content';
---
<section id="services" class="section-y bg-ivory" aria-labelledby="services-title">
  <div class="container-x">
    <header class="grid gap-6 lg:grid-cols-2 lg:items-end">
      <div>
        <SectionTag text="Signature Services" />
        <h2 id="services-title" class="h-section mt-5 max-w-lg" data-split>Bespoke Treatments Crafted for Your Well-being</h2>
      </div>
      <p class="lede max-w-md lg:justify-self-end" data-reveal>
        Three rituals our guests return for most. Each is performed by a senior therapist and tailored on the day to your skin, scalp and mood.
      </p>
    </header>

    <ol class="mt-14 space-y-6 lg:space-y-10" data-stack>
      {services.map((s, i) => (
        <li class="lg:sticky" style={`top:calc(96px + ${i * 22}px)`} data-stack-card data-reveal>
          <article class="card grid origin-top gap-6 p-4 sm:p-5 md:grid-cols-[1fr_1.15fr] md:gap-8" data-stack-inner aria-labelledby={`svc-${i}`}>
            <div class="relative overflow-hidden rounded-2xl">
              <img src={s.image} alt="" class="aspect-[16/10] h-full w-full object-cover md:aspect-auto" loading="lazy" decoding="async" />
              <span class="absolute left-3 top-3 rounded-full bg-white/90 px-3 py-1 text-[11px] font-semibold text-ink backdrop-blur">
                {String(i + 1).padStart(2, '0')} / {String(services.length).padStart(2, '0')}
              </span>
            </div>

            <div class="flex flex-col py-2 pr-2 md:gap-0">
              <h3 id={`svc-${i}`} class="font-serif text-3xl sm:text-[2.2rem]">{s.title}</h3>
              <p class="lede mt-3 max-w-prose">{s.text}</p>

              <p class="mt-6 text-[11px] font-semibold uppercase tracking-[0.18em] text-accent">Core features</p>
              <ul class="mt-3 grid gap-x-6 gap-y-2.5 sm:grid-cols-2">
                {s.features.map((f) => (
                  <li class="flex items-center gap-2.5 text-sm">
                    <span class="grid h-5 w-5 place-items-center rounded-full bg-accent text-white"><Icon name="check" size={11} /></span>{f}
                  </li>
                ))}
              </ul>

              <div class="mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-sand pt-5">
                <div class="flex items-center gap-3">
                  <img src={s.therapist.image.replace('w=700', 'w=96')} alt="" class="h-10 w-10 rounded-full object-cover" loading="lazy" />
                  <div>
                    <p class="text-sm font-semibold">{s.therapist.name}</p>
                    <p class="text-xs text-muted">{s.therapist.role}</p>
                  </div>
                </div>
                <div class="flex items-center gap-3">
                  <span class="chip"><Icon name="clock" size={12} />{s.duration}</span>
                  <Button label="View Service" variant="light" href="#pricing" ariaLabel={`View service: ${s.title}`} />
                </div>
              </div>
            </div>
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>
